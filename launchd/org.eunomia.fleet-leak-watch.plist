<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fleet-leak-watch — scan new transcript bytes every 2 min; ntfy on a new finding.
  Install (opshost): set FLEET_NTFY_URL to the Fleet-ops push URL, then
    mkdir -p ~/dev/.fleet
    cp launchd/org.eunomia.fleet-leak-watch.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.eunomia.fleet-leak-watch.plist
  Verify (PROVENANCE §8.3 — see it page before trusting it): drop a line
  containing `eyJdummy.dummy` into a scratch transcript under a fake projects dir
  and confirm an ntfy arrives. The install's FIRST run baseline-sweeps the whole
  corpus and pages once per pre-existing finding — triage those, then it's quiet.

  RUNS FROM THE PINNED WORKTREE, not ~/dev/eunomia. Until 2026-09-07 this unit
  executed the shared clone, so every 120 seconds it ran whatever branch a
  session had last left checked out there. That clone was observed on three
  different branches in one afternoon. It is the same defect fleet-secret-guard
  had (fixed by pinning) and the same one fleet-watch now reports as `pin-drift`.
  A scheduled job is the worst place for it: nobody is watching when it fires.

  The pin is a detached worktree of this repo at ~/.local/share/pins/eunomia. It
  is the pinned eunomia deployment, shared by several units and the PreToolUse
  hook. It was called fleet-guard until 2026-09-07, when both pins were
  collected under ~/.local/share/pins/<repo>.
  Updating it is deliberate: fetch, then checkout with the detach flag onto
  origin/main. (MOVING it to another path is a different operation with its
  own procedure — see bin/fleet-secret-guard.) fleet-watch reports when it falls behind.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.eunomia.fleet-leak-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/operator/.local/share/pins/eunomia/bin/fleet-leak-watch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- replace with the real Fleet-ops push URL at install; empty = print-only -->
    <key>FLEET_NTFY_URL</key><string></string>
  </dict>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/operator/dev/.fleet/leak-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/operator/dev/.fleet/leak-watch.log</string>
</dict>
</plist>
