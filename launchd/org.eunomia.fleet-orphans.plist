<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  fleet-orphans — daily sweep for a branch carrying work with no pull request
  (plan 0020). The `all` flag below: the timer does NOT scan only
  config/repos.conf's rows — the orphans the 2026-09-07 audit found were in
  infra, loyalty and pr-proxy, none of which had a row, and no row on this
  fleet carries `dispatch` either (§3 of the plan). Daily, alongside the leak
  watcher.

  Install (opshost): set FLEET_NTFY_URL to the Fleet-ops push URL, then
    mkdir -p ~/dev/.fleet
    cp launchd/org.eunomia.fleet-orphans.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.eunomia.fleet-orphans.plist
  Verify (PROVENANCE §8.3 — see it page before trusting it): run fleet-orphans
  with the all and dry-run flags by hand first and confirm the report names a
  repository count. The first
  real run baseline-pages once per pre-existing orphan; triage those, then
  it is quiet until the next branch goes quiet for a day.

  RUNS FROM THE PINNED WORKTREE, not ~/dev/eunomia — the shared clone sits on
  whatever branch a session last left it on (fleet-leak-watch's own plist
  carries the same note, and the same postmortem). The pin is a detached
  worktree of this repo at ~/.local/share/pins/eunomia; fleet-watch reports
  when it falls behind.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.eunomia.fleet-orphans</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/operator/.local/share/pins/eunomia/bin/fleet-orphans</string>
    <string>--all</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- replace with the real Fleet-ops push URL at install; empty = print-only -->
    <key>FLEET_NTFY_URL</key><string></string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/operator/dev/.fleet/orphans.log</string>
  <key>StandardErrorPath</key><string>/Users/operator/dev/.fleet/orphans.log</string>
</dict>
</plist>
