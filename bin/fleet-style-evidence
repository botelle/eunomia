#!/usr/bin/env python3
"""fleet-style-evidence — photograph a style pull request and commit the images
(ADR-0025 §6, plan 0151).

  fleet-style-evidence produce <repo> <pr> [--plan <path>] --worktree <dir>
                               --base <sha> --head <sha>

Photographs the base and the head with the repository's declared command, commits
the images to the pull request branch in their own commit after the code, writes
the producer's record outside every repository, checks the result with
`fleet-style verify`, pushes, and writes the before/after grid into the pull
request body. Exit 0 only when the body section was written and read back; every
other outcome exits non-zero and names the step. docs/style-evidence.md has the
contract.

The decisions that matter, and why:
  * The command is read from the BASE commit's blob and run for both sides. The
    head's copy is author-written, and a pull request that could change the
    program photographing it could photograph anything.
  * The simulator is created by this run, booted through `fleet-sim`, and
    deleted in a `finally`. The runtime is passed to `simctl create` literally
    and every expansion is quoted: given no runtime, or an empty unquoted one,
    `simctl create` exits 0 on the newest installed OS.
  * An earlier round's folder is removed in a commit of its own, under the code
    head, and the images go in the next commit. `fleet-style verify` accepts a
    head commit that only ADDS files inside one folder, so a replace in a single
    commit (which is a modification when the date and id repeat) would fail it.
  * The producer's record is the anchor ADR-0025 §9 relies on, so only this
    program writes it, under the fleet dir and never in a repository.
  * No flag raises the time bound: a bound an unattended process can raise for
    itself is not a bound.
"""
import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

BIN = Path(__file__).resolve().parent


def _load(path, name):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


style = _load(BIN / "fleet-style", "_fleet_style")
lib = _load(BIN / "fleetlib.py", "fleetlib")
forgelib = _load(BIN / "fleetforge.py", "_fleetforge")

BEGIN = "<!-- style-evidence:begin -->"
END = "<!-- style-evidence:end -->"
NAME = re.compile(r"[a-z0-9][a-z0-9-]*\Z")
# The command inherits nothing else: it builds and runs code the pull request's
# author wrote, so it gets no forge token, no agent socket and no cloud key.
CMD_ENV = ("PATH", "HOME", "LANG", "LC_ALL", "LC_CTYPE", "TMPDIR", "TZ", "USER",
           "LOGNAME", "SHELL", "TERM", "DEVELOPER_DIR", "FLEET_SIMCTL")


class Refuse(Exception):
    """A refusal that names the step it happened at."""

    def __init__(self, step, why):
        super().__init__(f"step {step}: {why}")
        self.step = step


def say(msg):
    print(f"fleet-style-evidence: {msg}", file=sys.stderr)


# ----------------------------------------------------------------------- git


def git(*args, cwd=None, check=True, step=7):
    try:
        r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True,
                           timeout=300)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refuse(step, f"git {args[0]}: {e.__class__.__name__}")
    if check and r.returncode != 0:
        raise Refuse(step, f"git {' '.join(args[:2])}: {r.stderr.strip()[:200]}")
    return r.stdout.strip() if check else r


def git_bytes(*args, cwd=None, step=7):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, timeout=300)
    if r.returncode != 0:
        raise Refuse(step, f"git {' '.join(args[:2])}: "
                           f"{r.stderr.decode(errors='replace').strip()[:200]}")
    return r.stdout


# --------------------------------------------------------------------- forge


def forge_client():
    # Cross-repo host tool: operator/hosttools, bin/fetch-forgejo-token.sh,
    # installed at ~/bin/, at e6227b5 (its last change). Contract relied on:
    # it exits 0 and prints the implbot PAT as the last non-empty line of
    # stdout, and exits non-zero when it cannot. ADR-0022 §2.
    cmd = os.environ.get("FLEET_AUTHOR_TOKEN_CMD", "").strip() \
        or os.path.expanduser("~/bin/fetch-forgejo-token.sh")
    try:
        r = subprocess.run(["sh", "-c", cmd], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refuse(1, f"the token helper did not run ({e.__class__.__name__})")
    lines = [l.strip() for l in r.stdout.splitlines() if l.strip()]
    if r.returncode != 0 or not lines:
        raise Refuse(1, "the token helper produced no token")
    return forgelib.Forge(forge_url(), lines[-1], timeout=60)


def forge_url():
    return os.environ.get("FLEET_FORGEJO_URL", "http://forge.example:3000").rstrip("/")


# ----------------------------------------------------------------- simulator


def simctl():
    return shlex.split(os.environ.get("FLEET_SIMCTL", "xcrun simctl"))


def run_simctl(*args, step=3, timeout=180):
    try:
        r = subprocess.run(simctl() + list(args), capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refuse(step, f"simctl {args[0]}: {e.__class__.__name__}")
    return r


def host_name():
    import socket
    return socket.gethostname().split(".")[0].lower()


class Simulator:
    """The lease, the device and the boot, undone in reverse on every exit."""

    def __init__(self, shot, ident):
        self.shot, self.ident = shot, ident
        self.lease = None
        self.own_lease = False
        self.udid = None
        self.runtime_reported = None

    def __enter__(self):
        try:
            self._start()
        except BaseException:
            self.__exit__(None, None, None)
            raise
        return self

    def _start(self):
        runtime, device = self.shot["runtime"], self.shot["device"]
        if not runtime or not runtime.strip():
            raise Refuse(3, "the declared runtime is empty; simctl would pick the newest OS")
        sid = lib.session_id()
        host = host_name()
        for rec in lib.all_leases():
            res = lib.resource_of(rec)
            if (rec.get("state") == "active" and rec.get("holder") == sid
                    and res.get("type") == "sim" and str(res.get("host", "")).lower() == host
                    and not res.get("udid")):
                self.lease = rec["id"]          # a lease the caller already holds
                break
        if self.lease is None:
            r = subprocess.run([sys.executable, str(BIN / "fleet-claim"), "--assign",
                                json.dumps({"type": "sim", "host": host}), "--holder", sid,
                                "--note", f"fleet-style-evidence {self.ident}"],
                               capture_output=True, text=True, timeout=60)
            lines = r.stdout.split()
            if r.returncode != 0 or not lines:
                raise Refuse(3, f"no sim lease: {r.stderr.strip()[:200]}")
            self.lease, self.own_lease = lines[-1], True
            r = subprocess.run([sys.executable, str(BIN / "fleet-claim"), "--activate",
                                self.lease], capture_output=True, text=True, timeout=60)
            if r.returncode != 0:
                raise Refuse(3, f"sim lease not activated: {r.stderr.strip()[:200]}")
        r = run_simctl("create", f"fleet-style-{self.ident}-{os.getpid()}", device, runtime)
        udid = r.stdout.strip().splitlines()[-1].strip() if r.stdout.strip() else ""
        if r.returncode != 0 or not udid:
            raise Refuse(3, f"simctl create failed: {r.stderr.strip()[:200]}")
        self.udid = udid
        r = subprocess.run([sys.executable, str(BIN / "fleet-sim"), "boot", udid],
                           capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            raise Refuse(3, f"fleet-sim boot refused: {(r.stderr or r.stdout).strip()[:200]}")
        self.runtime_reported = self._runtime_of(udid)
        if self.runtime_reported != runtime:
            raise Refuse(3, f"the booted device reports runtime {self.runtime_reported!r}, "
                            f"not the declared {runtime!r}")

    @staticmethod
    def _runtime_of(udid):
        r = run_simctl("list", "devices", "-j")
        try:
            for rt, devs in json.loads(r.stdout)["devices"].items():
                if any(d.get("udid") == udid for d in devs):
                    return rt
        except (ValueError, KeyError, TypeError, AttributeError):
            pass
        return None

    def __exit__(self, *exc):
        if self.udid:
            subprocess.run([sys.executable, str(BIN / "fleet-sim"), "shutdown", self.udid],
                           capture_output=True, text=True, timeout=300)
            r = run_simctl("delete", self.udid)
            if r.returncode != 0:
                say(f"WARN could not delete simulator {self.udid}: {r.stderr.strip()[:200]}")
        if self.lease and self.own_lease:
            subprocess.run([sys.executable, str(BIN / "fleet-release"), self.lease],
                           capture_output=True, text=True, timeout=60)
        return False


# --------------------------------------------------------------------- shots


def run_command(cmd, tree, out, udid, shot, side):
    argv = [str(cmd), "--out", str(out), "--udid", udid,
            "--themes", ",".join(shot["themes"]),
            "--appearances", ",".join(shot["appearances"])]
    env = {k: os.environ[k] for k in CMD_ENV if k in os.environ}
    bound = shot["timeout_minutes"] * 60
    proc = subprocess.Popen(argv, cwd=str(tree), env=env, start_new_session=True,
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    try:
        _, err = proc.communicate(timeout=bound)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        raise Refuse(4, f"the {side} run exceeded timeout_minutes={shot['timeout_minutes']}")
    if proc.returncode != 0:
        tail = (err or "").strip().splitlines()[-1:] or [""]
        raise Refuse(4, f"the {side} run exited {proc.returncode}: {tail[0][:200]}")


def collect(out, shot, side):
    """{(combo, screen): path} from `<out>/<theme>/<appearance>/<screen>.png` only."""
    found = {}
    for t in shot["themes"]:
        for a in shot["appearances"]:
            d = Path(out) / t / a
            if not d.is_dir() or d.is_symlink():
                raise Refuse(4, f"the {side} run wrote no {t}/{a}/ directory")
            for f in sorted(d.iterdir()):
                if f.suffix != ".png" or not NAME.match(f.stem):
                    continue
                if f.is_symlink() or not f.is_file():
                    raise Refuse(4, f"{side} {t}/{a}/{f.name} is not a regular file")
                found[(f"{t}-{a}", f.stem)] = f
    return found


def png_size(data):
    if data[:8] != style.PNG_SIG or data[12:16] != b"IHDR":
        raise ValueError("not a PNG")
    return struct.unpack(">II", data[16:24])


def strip_chunks(data):
    """The same PNG with only the chunks `fleet-style verify` allows."""
    out, pos = [data[:8]], 8
    while pos + 12 <= len(data):
        (length,) = struct.unpack(">I", data[pos:pos + 4])
        end = pos + 12 + length
        if data[pos + 4:pos + 8] in style.PNG_CHUNKS:
            out.append(data[pos:end])
        pos = end
    return b"".join(out)


def process_image(src, scale, cap, tmp, label):
    data = Path(src).read_bytes()
    try:
        w, h = png_size(data)
    except (ValueError, struct.error):
        raise Refuse(5, f"{label} is not a PNG")
    target = max(1, max(w, h) // scale)
    dst = Path(tmp) / "sized.png"
    if dst.exists():
        dst.unlink()
    try:
        r = subprocess.run(["sips", "-Z", str(target), str(src), "--out", str(dst)],
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refuse(5, f"sips would not run ({e.__class__.__name__})")
    if r.returncode != 0 or not dst.is_file():
        raise Refuse(5, f"sips failed on {label}: {r.stderr.strip()[:200]}")
    clean = strip_chunks(dst.read_bytes())
    problems = style.png_problems(clean, cap)
    if problems:
        raise Refuse(5, f"{label}: {problems[0]}")
    return clean


# ------------------------------------------------------------------- folders


def table(rows, url):
    lines = ["| screen | theme-appearance | before | after |", "|---|---|---|---|"]
    for combo, screen in rows:
        b, a = (url(f"{combo}/{screen}-{k}.png") for k in ("before", "after"))
        lines.append(f"| {screen} | {combo} | ![before]({b}) | ![after]({a}) |")
    return "\n".join(lines)


def readme_text(rows, block, total):
    return ("# Screenshots\n\n"
            + table(rows, lambda rel: rel) + "\n\n"
            + f"{len(block['images'])} images, {total} bytes in total.\n\n"
            + "```json\n" + json.dumps(block, indent=2, sort_keys=True) + "\n```\n")


def with_section(body, section):
    body = body or ""
    i, j = body.find(BEGIN), body.find(END)
    if i >= 0 and j > i:
        return body[:i] + section + body[j + len(END):]
    return (body.rstrip() + "\n\n" if body.strip() else "") + section + "\n"


# ------------------------------------------------------------------- produce


def produce(args):
    repo, pr = args.repo, args.pr
    if not style.REPO_NAME.fullmatch(repo):
        raise Refuse(1, f"{repo!r} is not owner/repo")
    owner, name = repo.split("/")
    ident = f"pr{pr}"
    if args.plan:
        text = Path(args.plan).read_text()
        pid = style._front_matter(text).get("id", "")
        if not NAME.match(pid):
            raise Refuse(1, "the plan has no usable id")
        ident = pid
    wt = Path(args.worktree).resolve()

    # 1. the declaration, and the head
    try:
        entry = style.declared(repo)
    except style.Malformed as e:
        raise Refuse(1, f"the style declaration is malformed: {e}")
    if entry is None:
        raise Refuse(1, f"{repo} declares no style paths")
    shot = entry["screenshot"]
    if shot["platform"] != "ios-simulator":
        raise Refuse(1, f"platform {shot['platform']!r} is not supported")
    if not shot["runtime"].strip():
        raise Refuse(1, "the declared runtime is empty")
    ed = entry["evidence_dir"]
    head = git("rev-parse", "--verify", f"{args.head}^{{commit}}", cwd=wt, step=1)
    base = git("rev-parse", "--verify", f"{args.base}^{{commit}}", cwd=wt, step=1)
    if git("rev-parse", "HEAD", cwd=wt, step=1) != head:
        raise Refuse(1, "--head is not the worktree's checked-out commit")
    if git("status", "--porcelain", "--untracked-files=no", cwd=wt, step=1):
        raise Refuse(1, "the worktree has uncommitted changes")
    forge = forge_client()
    st, pull = forge.get_pull(repo, pr)
    if st != 200 or not isinstance(pull, dict):
        raise Refuse(1, f"could not read the pull request (status {st})")
    if ((pull.get("head") or {}).get("sha") or "") != head:
        raise Refuse(1, "--head is not the pull request's current head")
    if pull.get("state") != "open" or pull.get("merged"):
        raise Refuse(1, "the pull request is not open")
    branch = (pull.get("head") or {}).get("ref") or ""
    if not branch:
        raise Refuse(1, "the pull request names no head branch")
    revs, pages = [], forgelib.paged(forge.list_reviews, repo, pr, cap=10)
    for page in pages:
        revs.extend(page)
    if pages.outcome != forgelib.EXHAUSTED:
        raise Refuse(1, "could not read the pull request's reviews")
    if any((r.get("state") or "").upper() == "APPROVED" and not r.get("dismissed")
           and not r.get("stale") for r in revs):
        raise Refuse(1, "the pull request has an approval; it is frozen")

    tmp = Path(tempfile.mkdtemp(prefix="style-evidence-"))
    base_tree = tmp / "base"
    pushed = False
    committed_from = head
    try:
        # 2. the base tree and the base commit's command
        git("worktree", "add", "--detach", str(base_tree), base, cwd=wt, step=2)
        blob = git("rev-parse", f"{base}:{shot['command']}", cwd=wt, step=2)
        cmd = tmp / "screenshot-command"
        cmd.write_bytes(git_bytes("show", f"{base}:{shot['command']}", cwd=wt, step=2))
        cmd.chmod(0o700)

        # 3-4. the simulator and the two runs
        out = {"base": tmp / "out-base", "head": tmp / "out-head"}
        with Simulator(shot, ident) as sim:
            for side, tree in (("base", base_tree), ("head", wt)):
                out[side].mkdir()
                run_command(cmd, tree, out[side], sim.udid, shot, side)
            runtime = sim.runtime_reported
        before, after = collect(out["base"], shot, "base"), collect(out["head"], shot, "head")
        if not before:
            raise Refuse(4, "the base run wrote no screens")
        if set(before) != set(after):
            gone = sorted(set(before) ^ set(after))
            raise Refuse(4, f"base and head disagree on screens: {gone}")
        combos = {f"{t}-{a}" for t in shot["themes"] for a in shot["appearances"]}
        screens = {s for _, s in before}
        for c in combos:
            if {s for cc, s in before if cc == c} != screens:
                raise Refuse(4, f"{c} lacks a screen the other combinations have")

        # 5. the images
        cap = shot["max_image_kb"] * 1024
        work = tmp / "work"
        work.mkdir()
        payload = {}
        for kind, found in (("before", before), ("after", after)):
            for (combo, screen), src in sorted(found.items()):
                payload[f"{combo}/{screen}-{kind}.png"] = process_image(
                    src, shot["scale"], cap, work, f"{kind} {combo}/{screen}")

        # 6. the folder
        now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
        folder = f"{ed}/{now.strftime('%Y-%m-%d')}-{ident}"
        images = [{"path": f"{folder}/{rel}", "bytes": len(d),
                   "sha256": hashlib.sha256(d).hexdigest()} for rel, d in sorted(payload.items())]
        total = sum(i["bytes"] for i in images)
        block = {"v": 1, "id": ident, "pr": pr, "taken": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
                 "base": base, "code_head": None, "platform": shot["platform"],
                 "runtime": runtime, "device": shot["device"], "command": shot["command"],
                 "command_blob": blob, "images": images}
        rows = sorted(set((c, s) for c, s in before))

        # An earlier round's folder: named for this id, absent at base. A folder at
        # base is never touched.
        at_base = {Path(p).name for p in git(
            "ls-tree", "--name-only", base, f"{ed}/", cwd=wt, step=6).splitlines()}
        at_head = {Path(p).name for p in git(
            "ls-tree", "--name-only", head, f"{ed}/", cwd=wt, step=6).splitlines()}
        old = sorted(n for n in at_head - at_base
                     if re.fullmatch(r"\d{4}-\d{2}-\d{2}-" + re.escape(ident), n))
        parent = head
        if old:
            for n in old:
                git("rm", "-r", "-q", "--", f"{ed}/{n}", cwd=wt, step=6)
            git("commit", "-q", "-m", f"screenshots: drop the earlier round of {ident}",
                cwd=wt, step=6)
            parent = git("rev-parse", "HEAD", cwd=wt, step=6)
        block["code_head"] = parent
        (wt / folder).mkdir(parents=True, exist_ok=False)
        for rel, d in payload.items():
            p = wt / folder / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_bytes(d)
        (wt / folder / "README.md").write_text(readme_text(rows, block, total))

        # 7. the commit, the record, the verification, the push
        git("add", "-A", "--", folder, cwd=wt)
        git("commit", "-q", "-m", f"screenshots: {ident} at {head[:8]}", cwd=wt)
        sha = git("rev-parse", "HEAD", cwd=wt)
        changed = git("diff", "--name-only", f"{parent}", sha, cwd=wt).splitlines()
        if not changed or any(not c.startswith(folder + "/") for c in changed):
            raise Refuse(7, "the evidence commit changes more than its folder")
        rec = style.record_path(repo, pr, sha)
        rec.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(rec, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"v": 1, "repo": repo, "pr": pr, "evidence_commit": sha,
                       "images": images}, f, indent=2)
        gd = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=wt)
        res = style.verify(repo, pr, ident if args.plan else "none", style.Git(gd), base, sha)
        if not res["ok"]:
            rec.unlink(missing_ok=True)
            raise Refuse(7, "fleet-style verify refused the evidence: "
                            + "; ".join(res["problems"][:3]))
        git("push", "origin", f"{sha}:refs/heads/{branch}", cwd=wt)
        pushed = True

        # 8. the body
        raw = f"{forge_url()}/{repo}/raw/commit/{sha}/{folder}/"
        section = (f"{BEGIN}\n" + table(rows, lambda rel: raw + rel)
                   + f"\n\nTotal size of `{folder}`: {total / 1024:.1f} KB "
                     f"({len(images)} images).\n{END}")
        st, fresh = forge.get_pull(repo, pr)
        if st != 200 or not isinstance(fresh, dict):
            raise Refuse(8, f"could not re-read the body (status {st})")
        new = with_section(fresh.get("body") or "", section)
        st, _ = forge.edit_pull_body(repo, pr, new)
        if st is None or not (200 <= int(st) < 300):
            raise Refuse(8, f"the body edit returned {st}")
        st, back = forge.get_pull(repo, pr)
        if st != 200 or not isinstance(back, dict) or section not in (back.get("body") or ""):
            raise Refuse(8, "the edit reported success and the body does not carry the grid")
        print(json.dumps({"ok": True, "evidence_commit": sha, "folder": folder,
                          "images": len(images), "total_bytes": total}))
        return sha
    except BaseException:
        if not pushed and git("rev-parse", "HEAD", cwd=wt, check=False, step=7).stdout.strip() \
                != committed_from:
            # Our own unpushed commits only: the worktree was clean at `head`.
            git("reset", "-q", "--hard", committed_from, cwd=wt, check=False)
        raise
    finally:
        git("worktree", "remove", "--force", str(base_tree), cwd=wt, check=False)
        shutil.rmtree(tmp, ignore_errors=True)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="fleet-style-evidence")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("produce")
    p.add_argument("repo")
    p.add_argument("pr", type=int)
    p.add_argument("--plan")
    p.add_argument("--worktree", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--head", required=True)
    args = ap.parse_args(argv)
    try:
        produce(args)
    except Refuse as e:
        print(f"fleet-style-evidence: {e}", file=sys.stderr)
        return 1
    except style.Undecided as e:
        print(f"fleet-style-evidence: step 7: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
