_lib_spec = importlib.util.spec_from_loader("fleetlib", _lib_loader)
lib = importlib.util.module_from_spec(_lib_spec)
_lib_loader.exec_module(lib)

# NOT `import fleetforge` (plan 0051 boundary): this file is SourceFileLoader'd
# from two directories that are not on sys.path — ~/.local/share/pins/eunomia/bin
# and keyvault's forgejo-broker deployment on vaulthost — and a plain import passes
