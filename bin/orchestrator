     "--ignore-user-config", "--ephemeral", "--ignore-rules", "--json",
     "-c", 'sqlite_home="<lane>"',
     "--output-schema", "<schema>", "-o", "<out>",
     "-m", "gpt-6-astra"),
    False, "local_cli", (), "",
    "openai", provenance="us-hosted", model="gpt-6-astra",
    # Implements under codex's own `workspace-write` sandbox, not the tester
    # profile above (inside that profile codex gets no shell, and an
    # implementer has to run the tests). Measured 2026-11-02: it wrote in
    # the worktree and got "operation not permitted" for a path under $HOME
